{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/depkb/claude/hooks/depkb_hook.py\" session", "timeout": 60 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/depkb/claude/hooks/depkb_hook.py\" guard", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/depkb/claude/hooks/depkb_hook.py\" after-edit", "timeout": 900 }
        ]
      }
    ]
  }
}
